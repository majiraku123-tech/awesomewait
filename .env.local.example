# ============================================================
# FestivalFlow AI — 環境変数設定テンプレート
# ============================================================
# このファイルを .env.local にコピーして実際の値を設定してください。
# ⚠️ .env.local は絶対に Git にコミットしないこと。
# ============================================================

# ──────────────────────────────────────────────
# Supabase 設定（必須）
# Supabase ダッシュボード → Settings → API から取得
# ──────────────────────────────────────────────

# Supabase プロジェクト URL（公開可能）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key（公開可能・RLSで保護）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key（サーバーサイドのみ・絶対に公開しないこと）
# NEXT_PUBLIC_ プレフィックスを付けないこと
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────
# アプリケーション設定
# ──────────────────────────────────────────────

# 本番URL（OGP タグ・メタデータ生成に使用）
NEXT_PUBLIC_BASE_URL=https://festivalflow-ai.vercel.app

# ──────────────────────────────────────────────
# 開発環境専用（本番では設定不要）
# ──────────────────────────────────────────────

# Next.js ログレベル
# NODE_ENV=development
